# Core
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# auth-jwt module
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# db-mongoose module
MONGO_URI=mongodb://localhost:27017/myapp

# db-pg module
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=myapp

# db-prisma module
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myapp?schema=public
